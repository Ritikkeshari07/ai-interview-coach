# Choose one real provider: nvidia (default) or openai. Keep this file's placeholders; never commit .env.
AI_PROVIDER=nvidia
# NVIDIA's hosted NIM API (used when AI_PROVIDER=nvidia)
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# Alternate provider (used when AI_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
PORT=8080
NODE_ENV=production
# Set true for no-key local development only. Production must use false.
MOCK_AI=true
CLIENT_ORIGIN=
